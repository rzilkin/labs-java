					"name": "Create Analytic Function",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    try {",
									"        const responseText = pm.response.text();",
									"        console.log('Response text:', responseText);",
									"        const response = pm.response.json();",
									"        console.log('Parsed response:', JSON.stringify(response));",
									"        ",
									"        // Try to save variable regardless of test result",
									"        if (response && typeof response === 'object') {",
									"            if (response.id !== undefined && response.id !== null) {",
									"                const idStr = String(response.id);",
									"                pm.collectionVariables.set('function_id_1', idStr);",
									"                console.log('✅ Saved function_id_1 =', idStr);",
									"                pm.test('Variable saved successfully', function () {",
									"                    const saved = pm.collectionVariables.get('function_id_1');",
									"                    pm.expect(saved).to.equal(idStr);",
									"                });",
									"            } else {",
									"                console.log('❌ No ID in response object:', response);",
									"            }",
									"        } else {",
									"            console.log('❌ Response is not an object:', typeof response, response);",
									"        }",
									"        ",
									"        // Test that response has id",
									"        pm.test('Response has id property', function () {",
									"            pm.expect(response).to.have.property('id');",
									"        });",
									"    } catch (e) {",
									"        console.log('❌ Error parsing response:', e.message);",
									"        console.log('Response text:', pm.response.text());",
